                    <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🔄</div>
                    <h3 style="font-family: 'Orbitron', monospace; font-weight: 700; font-size: 0.9rem;">Updateable</h3>
                    <p style="color: var(--text-muted); font-family: 'Rajdhani', sans-serif; font-size: 0.85rem;">Change URL anytime</p>
                </div>
                <div class="glass-card neon-glow-pink" style="text-align: center;">
                    <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">📊</div>
                    <h3 style="font-family: 'Orbitron', monospace; font-weight: 700; font-size: 0.9rem;">Analytics</h3>
                    <p style="color: var(--text-muted); font-family: 'Rajdhani', sans-serif; font-size: 0.85rem;">Track every click</p>
                </div>
                <div class="glass-card neon-glow-cyan" style="text-align: center;">
                    <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🔒</div>
                    <h3 style="font-family: 'Orbitron', monospace; font-weight: 700; font-size: 0.9rem;">Password Protect</h3>
                    <p style="color: var(--text-muted); font-family: 'Rajdhani', sans-serif; font-size: 0.85rem;">Secure your links</p>
                </div>
                <div class="glass-card neon-glow-purple" style="text-align: center;">
                    <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">📱</div>
                    <h3 style="font-family: 'Orbitron', monospace; font-weight: 700; font-size: 0.9rem;">QR Code</h3>
                    <p style="color: var(--text-muted); font-family: 'Rajdhani', sans-serif; font-size: 0.85rem;">Download QR for any link</p>
                </div>
