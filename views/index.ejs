                    <h3 style="font-family: 'Orbitron', monospace; font-weight: 700; font-size: 0.9rem;">Bot Protection</h3>
                    <p style="color: var(--text-muted); font-family: 'Rajdhani', sans-serif; font-size: 0.85rem;">Block bot clicks</p>
                </div>
            </div>

            <!-- Live Users -->
            <div class="glass-card neon-glow-cyan fade-in" style="margin-top: 2rem;">
                <h3 style="font-family: 'Orbitron', monospace; font-weight: 700;">👥 Live Users</h3>
