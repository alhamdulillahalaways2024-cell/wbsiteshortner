            const lastName = document.getElementById('editLastName').value.trim();
            
            if (!firstName) {
                showToast('First name is required', 'error');
                return;
            }

            try {
                const response = await fetch('/api/update-profile', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ first_name: firstName, last_name: lastName })
                });

                const data = await response.json();
                
                if (data.success) {
                    showToast('Profile updated successfully!', 'success');
                    loadProfileData();
                    document.querySelector('.user-profile-btn .user-name').textContent = data.user.display_name || data.user.first_name;
                    document.querySelector('.user-profile-btn .avatar').textContent = data.user.display_name.charAt(0).toUpperCase();
                    document.querySelector('.dropdown-menu .dd-name').textContent = data.user.display_name || data.user.first_name;
                } else {
                    showToast(data.error || 'Failed to update profile', 'error');
                }
            } catch (error) {
                showToast('Failed to update profile', 'error');
            }
        }

        async function saveDisplayName() {
            const displayName = document.getElementById('editDisplayName').value.trim();
            
            if (!displayName) {
                showToast('Display name is required', 'error');
                return;
            }

            try {
                const response = await fetch('/api/update-profile', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ display_name: displayName })
                });

                const data = await response.json();
                
                if (data.success) {
                    showToast('Profile updated successfully!', 'success');
                    loadProfileData();
                    document.querySelector('.user-profile-btn .user-name').textContent = data.user.display_name;
                    document.querySelector('.user-profile-btn .avatar').textContent = data.user.display_name.charAt(0).toUpperCase();
                    document.querySelector('.dropdown-menu .dd-name').textContent = data.user.display_name;
                } else {
                    showToast(data.error || 'Failed to update profile', 'error');
                }
            } catch (error) {
                showToast('Failed to update profile', 'error');
            }
        }

        async function saveEmail() {
            const email = document.getElementById('editEmail').value.trim();
            
            if (!email) {
                showToast('Email is required', 'error');
                return;
            }

            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email)) {
                showToast('Please enter a valid email address', 'error');
                return;
            }

            try {
                const response = await fetch('/api/update-profile', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email })
                });

                const data = await response.json();
                
                if (data.success) {
                    showToast('Email updated successfully!', 'success');
                    loadProfileData();
                    document.querySelector('.dropdown-menu .dd-email').textContent = data.user.email || 'No email set';
                } else {
                    showToast(data.error || 'Failed to update email', 'error');
                }
            } catch (error) {
                showToast('Failed to update email', 'error');
            }
        }

        // ============================================================
        // UPDATE TIMEZONE
        // ============================================================
        async function updateTimezone() {
            const select = document.getElementById('userTimezone');
            const timezone = select.value;
            
            if (!timezone) return;

            try {
                const response = await fetch('/api/update-timezone', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ timezone: timezone })
                });

                const data = await response.json();
                
                if (data.success) {
                    showToast('Timezone updated successfully!', 'success');
                    updateCurrentTime();
                } else {
                    showToast(data.error || 'Failed to update timezone', 'error');
                }
            } catch (error) {
                showToast('Failed to update timezone', 'error');
            }
        }

        // ============================================================
        // UPDATE CURRENT TIME
        // ============================================================
        function updateCurrentTime() {
            const select = document.getElementById('userTimezone');
            const timezone = select.value || 'Asia/Dhaka';
            const display = document.getElementById('currentTimeDisplay');
            
            if (display) {
                const now = new Date();
                const options = {
                    timeZone: timezone,
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit',
                    hour12: true
                };
                display.textContent = now.toLocaleString('en-US', options);
            }
        }

        setInterval(updateCurrentTime, 1000);

        // ============================================================
        // CONVERT LINK DATES TO USER TIMEZONE
        // ============================================================
        function convertLinkDates() {
            const select = document.getElementById('userTimezone');
            const timezone = select.value || 'Asia/Dhaka';
            
            document.querySelectorAll('.link-date').forEach(function(el) {
                const dateStr = el.getAttribute('data-date');
                if (dateStr) {
                    try {
                        const date = new Date(dateStr);
                        const options = {
                            timeZone: timezone,
                            year: 'numeric',
                            month: 'short',
                            day: 'numeric',
                            hour: '2-digit',
                            minute: '2-digit'
                        };
                        el.textContent = date.toLocaleString('en-US', options);
                    } catch (e) {}
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            const select = document.getElementById('userTimezone');
            if (select) {
                const userTimezone = '<%= typeof user !== "undefined" && user.timezone ? user.timezone : "Asia/Dhaka" %>';
                if (userTimezone) {
                    select.value = userTimezone;
                }
                updateCurrentTime();
                convertLinkDates();
                
                select.addEventListener('change', function() {
                    setTimeout(convertLinkDates, 500);
                });
            }
        });

        // ============================================================
        // TOAST NOTIFICATIONS
        // ============================================================
        function showToast(message, type = 'info', duration = 3000) {
            const container = document.getElementById('toastContainer');
            const icons = {
                success: 'fas fa-check-circle',
                error: 'fas fa-exclamation-circle',
                info: 'fas fa-info-circle'
            };

            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            toast.innerHTML = `
                <span class="toast-icon"><i class="${icons[type] || icons.info}"></i></span>
                <span class="toast-message">${message}</span>
                <button class="toast-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>
            `;

            container.appendChild(toast);

            setTimeout(() => {
                toast.style.animation = 'slideOutRight 0.4s ease forwards';
                setTimeout(() => {
                    if (toast.parentElement) {
                        toast.remove();
                    }
                }, 400);
            }, duration);
        }

        // ============================================================
        // COPY TO CLIPBOARD
        // ============================================================
        function copyToClipboard(text) {
            const cleanText = String(text).trim();
            
            if (!cleanText || cleanText === '') {
                showToast('❌ Error: Nothing to copy', 'error');
                return;
            }
            
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(cleanText).then(() => {
                    showToast('✅ Link copied to clipboard!', 'success');
                }).catch(() => {
                    fallbackCopy(cleanText);
                });
            } else {
                fallbackCopy(cleanText);
            }
        }

        function fallbackCopy(text) {
            try {
                const textarea = document.createElement('textarea');
                textarea.value = text;
                textarea.style.position = 'fixed';
                textarea.style.opacity = '0';
                textarea.style.width = '1px';
                textarea.style.height = '1px';
                document.body.appendChild(textarea);
                textarea.select();
                const success = document.execCommand('copy');
                document.body.removeChild(textarea);
                if (success) {
                    showToast('✅ Link copied to clipboard!', 'success');
                } else {
                    showToast('❌ Failed to copy. Please copy manually.', 'error');
                }
            } catch (err) {
                showToast('❌ Failed to copy. Please copy manually.', 'error');
            }
        }

        // ============================================================
        // QR CODE GENERATOR
        // ============================================================
        async function generateQR(shortCode) {
            try {
                const response = await fetch(`/qr/${shortCode}`);
                const data = await response.json();
                
                if (data.qr) {
                    const win = window.open('', '_blank');
                    win.document.write(`
                        <html>
                        <head><title>QR Code</title></head>
                        <body style="background:#0A0A0F;display:flex;justify-content:center;align-items:center;height:100vh;margin:0;font-family:'Orbitron',monospace;flex-direction:column;">
                            <div style="background:white;padding:20px;border-radius:12px;box-shadow:0 0 40px rgba(0,240,255,0.1);">
                                <img src="${data.qr}" style="max-width:300px;width:100%;">
                            </div>
                            <p style="color:#B0B0C8;margin-top:20px;font-size:14px;font-family:'Rajdhani',sans-serif;letter-spacing:1px;">Scan to visit: ${data.url}</p>
                            <button onclick="window.close()" style="margin-top:10px;padding:8px 20px;background:linear-gradient(135deg,#00F0FF,#9B59FF);border:none;border-radius:8px;color:#0A0A0F;cursor:pointer;font-family:'Rajdhani',sans-serif;font-weight:600;">Close</button>
                        </body>
                        </html>
                    `);
                }
            } catch (error) {
                showToast('❌ Failed to generate QR code', 'error');
            }
        }

        // ============================================================
        // COPY BUTTON EVENT LISTENERS
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.copy-link-btn').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const url = this.getAttribute('data-url');
                    copyToClipboard(url);
                });
            });
        });

        // ============================================================
        // UPDATE LIVE USER COUNT
        // ============================================================
        setInterval(async () => {
            try {
                const response = await fetch('/api/online-users');
                const data = await response.json();
                const countEl = document.getElementById('liveUserCount');
                if (countEl) {
                    countEl.textContent = (data.count || 0) + ' Online';
                }
                const listEl = document.getElementById('userList');
                if (listEl && data.users) {
                    if (data.users.length > 0) {
                        listEl.innerHTML = data.users.map(u =>
                            `<span class="user-badge"><span class="online-dot"></span>${u.name}</span>`
                        ).join('');
                    } else {
                        listEl.innerHTML = '<span style="color: var(--text-muted);">No users online</span>';
                    }
                }
            } catch (e) {}
        }, 10000);

        // ============================================================
        // FORM SUBMIT ANIMATION
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('shortenForm');
            const btn = document.getElementById('shortenBtn');
            if (form && btn) {
                form.addEventListener('submit', function() {
                    const original = btn.innerHTML;
                    btn.innerHTML = '⚡ Processing...';
                    btn.disabled = true;
                    btn.style.opacity = '0.7';
                    setTimeout(() => {
                        btn.innerHTML = original;
                        btn.disabled = false;
                        btn.style.opacity = '1';
                    }, 3000);
                });
            }
        });

        // ============================================================
        // ANALYTICS CHART
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            const ctx = document.getElementById('analyticsChart');
            if (ctx) {
                const weekData = <%= typeof weekData !== 'undefined' && weekData ? JSON.stringify(weekData) : '[0,0,0,0,0,0,0]' %>;
                
                const chart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                        datasets: [{
                            label: 'Clicks',
                            data: weekData,
                            borderColor: '#00F0FF',
                            backgroundColor: 'rgba(0, 240, 255, 0.08)',
                            borderWidth: 3,
                            pointBackgroundColor: '#9B59FF',
                            pointBorderColor: '#00F0FF',
                            pointBorderWidth: 2,
                            pointRadius: 5,
                            tension: 0.4,
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                labels: {
                                    color: '#B0B0C8',
                                    font: {
                                        family: 'Rajdhani',
                                        size: 12
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: {
                                    color: 'rgba(255,255,255,0.05)'
                                },
                                ticks: {
                                    color: '#B0B0C8',
                                    font: {
                                        family: 'Rajdhani',
                                        size: 11
                                    }
                                }
                            },
                            y: {
                                grid: {
                                    color: 'rgba(255,255,255,0.05)'
                                },
                                ticks: {
                                    color: '#B0B0C8',
                                    font: {
                                        family: 'Rajdhani',
                                        size: 11
                                    },
                                    stepSize: 1
                                },
                                beginAtZero: true
                            }
                        },
                        animation: {
                            duration: 2000,
                            easing: 'easeInOutQuart'
                        }
                    }
                });
            }
        });
    </script>

</body>
</html>
