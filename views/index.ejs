                        </select>
                        <span class="timezone-display" id="currentTimeDisplay">Loading time...</span>
                    </div>
                </div>

                <!-- ========================================================== -->
                <!-- COUNTRY & DEVICE STATS -->
                <!-- ========================================================== -->
                <div class="glass-card neon-glow-pink" style="margin-bottom: 2rem;">
                    <h3 style="font-family: 'Orbitron', monospace; margin-bottom: 0.5rem; font-weight: 700;">🌍 Visitor Analytics</h3>
                    <p style="color: var(--text-muted); font-family: 'Rajdhani', sans-serif; font-size: 0.85rem; margin-bottom: 1rem;">
                        See where your visitors are coming from, what devices they use, and bot protection status
                    </p>
                    
                    <div class="stats-grid-2col">
                        <!-- Countries -->
                        <div>
                            <h4 style="color: var(--text-muted); font-family: 'Rajdhani', sans-serif; font-size: 0.85rem; margin-bottom: 0.5rem;">🏳️ Top Countries</h4>
                            <div class="country-grid">
                                <% if (typeof countryStats !== 'undefined' && countryStats && countryStats.length > 0) { %>
                                    <% const maxCount = countryStats[0] ? countryStats[0].count : 1; %>
                                    <% countryStats.forEach(function(country) { 
                                        const percentage = Math.round((country.count / maxCount) * 100);
                                        const countryInfo = typeof countries !== 'undefined' && countries[country.countryCode] ? countries[country.countryCode] : null;
                                        const flag = countryInfo ? countryInfo.flag : '🌍';
                                        const name = countryInfo ? countryInfo.name : (country.country || 'Unknown');
                                    %>
                                        <div class="country-item">
                                            <span class="country-name">
                                                <span class="country-flag"><%= flag %></span>
                                                <span><%= name %></span>
                                            </span>
                                            <span style="display: flex; align-items: center; gap: 0.3rem;">
                                                <span class="country-clicks"><%= country.count %></span>
                                                <div class="country-bar">
                                                    <div class="bar-fill" style="width: <%= percentage %>%;"></div>
                                                </div>
                                            </span>
                                        </div>
                                    <% }); %>
                                <% } else { %>
                                    <p style="color: var(--text-muted); grid-column: 1 / -1; text-align: center; padding: 0.5rem; font-size: 0.85rem; font-family: 'Rajdhani', sans-serif;">
                                        No country data yet
                                    </p>
                                <% } %>
                            </div>
                        </div>
                        
                        <!-- Devices & Bot Protection -->
                        <div>
                            <h4 style="color: var(--text-muted); font-family: 'Rajdhani', sans-serif; font-size: 0.85rem; margin-bottom: 0.5rem;">📱 Devices & Bot Protection</h4>
                            <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                                <% if (typeof deviceStats !== 'undefined' && deviceStats && deviceStats.length > 0) { %>
                                    <% deviceStats.forEach(function(device) { %>
                                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.3rem 0.6rem; background: var(--glass); border-radius: 6px; border: 1px solid var(--glass-border);">
                                            <span class="device-tag">
                                                <%= device.device === 'Mobile' ? '📱' : device.device === 'Tablet' ? '📲' : '💻' %>
                                                <%= device.device || 'Unknown' %>
                                                <span style="color: var(--text-muted); font-size: 0.65rem;">
                                                    (<%= device.browser || 'Unknown' %> / <%= device.os || 'Unknown' %>)
                                                </span>
                                            </span>
                                            <span style="color: var(--neon-cyan); font-weight: 600; font-size: 0.8rem;"><%= device.count %></span>
                                        </div>
                                    <% }); %>
                                <% } else { %>
                                    <p style="color: var(--text-muted); text-align: center; padding: 0.5rem; font-size: 0.85rem; font-family: 'Rajdhani', sans-serif;">
                                        No device data yet
                                    </p>
                                <% } %>
                                
                                <!-- Bot Protection Status -->
                                <div style="margin-top: 0.5rem; padding: 0.5rem 0.8rem; background: var(--glass); border-radius: 8px; border: 1px solid var(--glass-border);">
                                    <div style="display: flex; justify-content: space-between; align-items: center;">
                                        <span style="color: var(--text-muted); font-family: 'Rajdhani', sans-serif; font-size: 0.8rem;">🤖 Bot Protection</span>
                                        <span style="color: var(--neon-green); font-weight: 600; font-size: 0.8rem; font-family: 'Orbitron', monospace;">✅ Active</span>
                                    </div>
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.2rem;">
                                        <span style="color: var(--text-muted); font-family: 'Rajdhani', sans-serif; font-size: 0.75rem;">Bot Clicks Blocked</span>
                                        <span style="color: var(--neon-pink); font-weight: 600; font-size: 0.8rem; font-family: 'Orbitron', monospace;"><%= typeof botClicks !== 'undefined' ? botClicks : 0 %></span>
                                    </div>
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.2rem;">
                                        <span style="color: var(--text-muted); font-family: 'Rajdhani', sans-serif; font-size: 0.75rem;">Real Clicks</span>
                                        <span style="color: var(--neon-green); font-weight: 600; font-size: 0.8rem; font-family: 'Orbitron', monospace;"><%= typeof realClicks !== 'undefined' ? realClicks : 0 %></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ========================================================== -->
                <!-- CREATE LINK FORM -->
                <!-- ========================================================== -->
                <div class="glass-card neon-glow-cyan" style="margin-bottom: 2rem;">
                    <h3 style="font-family: 'Orbitron', monospace; margin-bottom: 0.5rem; font-weight: 700;">🔗 Create New Short Link</h3>
                    <form action="/shorten" method="POST" class="shorten-form-inline">
                        <div class="form-group">
                            <input type="url" class="form-control" name="originalUrl"
                                   placeholder="Enter your long URL" required>
                        </div>
                        <div class="form-group">
                            <input type="text" class="form-control" name="customSlug"
                                   placeholder="Custom slug (optional)">
                        </div>
                        <div class="form-group" style="min-width: 120px;">
                            <select class="form-control" name="expiresIn">
                                <option value="">Never</option>
                                <option value="1d">1 Day</option>
                                <option value="7d">7 Days</option>
                                <option value="30d">30 Days</option>
                                <option value="90d">90 Days</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary">🚀 Shorten</button>
                    </form>
                </div>

                <!-- ===== LINKS LIST ===== -->
                <h2 style="font-family: 'Orbitron', monospace; margin-bottom: 1.5rem; font-weight: 700;">My Short Links</h2>

                <% if (typeof links !== 'undefined' && links && links.length > 0) { %>
                    <% links.forEach(function(link) { 
                        const linkUrl = link.shortUrl || '';
                        const linkId = link.id || link._id || '';
                        const linkCode = link.shortCode || '';
                        const linkOriginal = link.originalUrl || '';
                        const linkClicks = link.clicks || 0;
                        const linkCreated = link.createdAt || '';
                        const linkTitle = link.title || '';
                        const isExpired = link.isExpired || false;
                        const isActive = link.isActive !== undefined ? link.isActive : true;
                    %>
                        <div class="link-card">
                            <div class="link-top">
                                <div>
                                    <a href="/<%= linkCode %>" target="_blank" class="link-url">
                                        🔗 <%= linkUrl %>
                                    </a>
                                    <% if (linkTitle) { %>
                                        <div class="link-title"><%= linkTitle %></div>
                                    <% } %>
                                    <div class="link-original">→ <%= linkOriginal %></div>
                                </div>
                                <div style="display: flex; gap: 0.3rem; flex-wrap: wrap;">
                                    <button class="btn btn-secondary btn-sm copy-link-btn" 
                                            data-url="<%= linkUrl %>"
                                            style="flex-shrink: 0; cursor: pointer;">
                                        📋 Copy
                                    </button>
                                    <button class="btn btn-secondary btn-sm" 
                                            onclick="generateQR('<%= linkCode %>')"
                                            style="flex-shrink: 0; cursor: pointer;">
                                        📱 QR
                                    </button>
                                </div>
                            </div>
                            <div class="link-meta">
                                <span>👁️ <%= linkClicks %> clicks</span>
                                <span>📅 <span class="link-date" data-date="<%= linkCreated %>"><%= linkCreated %></span></span>
                                <span>🆔 <%= linkCode %></span>
                                <% if (isExpired) { %>
                                    <span class="badge badge-expired">⏰ Expired</span>
                                <% } else if (!isActive) { %>
                                    <span class="badge badge-inactive">⛔ Inactive</span>
                                <% } else { %>
                                    <span class="badge badge-active">✅ Active</span>
                                <% } %>
