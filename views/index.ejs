                <div class="profile-field">
                    <label><i class="fas fa-link" style="color: var(--warning); margin-right: 0.3rem;"></i> Total Links</label>
                    <div class="field-value">${data.totalLinks || 0}</div>
                </div>

                <div class="profile-field">
                    <label><i class="fas fa-mouse-pointer" style="color: var(--success); margin-right: 0.3rem;"></i> Total Clicks</label>
                    <div class="field-value">${data.totalClicks || 0}</div>
