                            </div>
                            <div class="stat-item">
                                <span class="label">📅 Today</span>
                                <span class="value success"><%= typeof todayClicks !== 'undefined' ? todayClicks : 0 %></span>
                            </div>
                            <div class="stat-item">
                                <span class="label">📈 This Week</span>
                                <span class="value"><%= typeof weekClicks !== 'undefined' ? weekClicks : 0 %></span>
                            </div>
                            <div class="stat-item">
                                <span class="label">📊 This Month</span>
                                <span class="value"><%= typeof monthClicks !== 'undefined' ? monthClicks : 0 %></span>
                            </div>
                            <div class="stat-item">
                                <span class="label">🤖 Bot Clicks</span>
                                <span class="value danger"><%= typeof botClicks !== 'undefined' ? botClicks : 0 %></span>
                            </div>
                            <div class="stat-item">
                                <span class="label">🟢 Real Clicks</span>
                                <span class="value success"><%= typeof realClicks !== 'undefined' ? realClicks : 0 %></span>
                            </div>
                            <div class="stat-item">
                                <span class="label">📊 Click Rate</span>
                                <span class="value"><%= typeof clickRate !== 'undefined' ? clickRate : 0 %>%</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ========================================================== -->
                <!-- TIMEZONE SELECTOR -->
                <!-- ========================================================== -->
                <div class="glass-card neon-glow-purple" style="margin-bottom: 2rem;">
                    <h3 style="font-family: 'Orbitron', monospace; margin-bottom: 0.5rem; font-weight: 700;">🕐 Your Timezone</h3>
                    <p style="color: var(--text-muted); font-family: 'Rajdhani', sans-serif; font-size: 0.85rem; margin-bottom: 0.5rem;">
                        Select your timezone to see link creation times in your local time
                    </p>
                    <div class="timezone-selector">
                        <span style="color: var(--text-muted); font-size: 0.85rem; font-family: 'Rajdhani', sans-serif;">🌍 Current Timezone:</span>
                        <select id="userTimezone" onchange="updateTimezone()">
                            <option value="Asia/Dhaka">🇧🇩 Bangladesh (Asia/Dhaka)</option>
                            <option value="Asia/Kolkata">🇮🇳 India (Asia/Kolkata)</option>
                            <option value="America/New_York">🇺🇸 USA (America/New_York)</option>
                            <option value="Europe/London">🇬🇧 UK (Europe/London)</option>
                            <option value="Europe/Berlin">🇩🇪 Germany (Europe/Berlin)</option>
